# Dependencies
node_modules/

# Environment variables and secrets (commit sanitized examples only)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Next.js and compiled output
.next/
out/
dist/
build/
next-env.d.ts
*.tsbuildinfo

# Logs and runtime files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.pid.lock

# Test and coverage output
coverage/
.nyc_output/
playwright-report/
test-results/

# Tool caches and local deployment metadata
.cache/
.turbo/
.eslintcache
.vercel/

# Backend files created at runtime
/backend/uploads/*
!/backend/uploads/.gitkeep

# Local editor files (allow shared VS Code configuration)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo

# Operating system files
.DS_Store
._*
Thumbs.db
desktop.ini

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Copy the pooled connection URL from Neon. Never commit the real URL.
# Use sslmode=verify-full for certificate verification.
DATABASE_URL=
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=10000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Leave empty for direct connections; otherwise specify trusted proxy IPs/CIDRs.
TRUST_PROXY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOG_LEVEL=info
